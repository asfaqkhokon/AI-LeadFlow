# ============================================
# AI-LeadFlow Environment Configuration
# ============================================

# Application
APP_NAME=AI-LeadFlow
APP_ENV=local
APP_URL=http://localhost:5678
TZ=Asia/Dhaka

# ============================================
# n8n
# ============================================

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
