# ============================================
# MySQL
# ============================================

DB_TYPE=mysqldb
DB_MYSQLDB_HOST=mysql
DB_MYSQLDB_PORT=3306
DB_MYSQLDB_DATABASE=n8n
DB_MYSQLDB_USER=n8n
DB_MYSQLDB_PASSWORD=change_me

# ============================================
# MySQL Container
# ============================================

MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=n8n
MYSQL_USER=n8n
MYSQL_PASSWORD=change_me

# ============================================
# AI Providers
# ============================================

OPENAI_API_KEY=
